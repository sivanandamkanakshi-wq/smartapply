# Flask and local runtime
FLASK_SECRET_KEY=replace_with_a_long_random_secret
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
ALLOW_LOCAL_DB_RESET=false
SMARTAPPLY_CORS_ALLOWED_ORIGINS=chrome-extension://your_extension_id

# Database: local SQLite path. PostgreSQL DATABASE_URL requires a separate adapter and migration.
DATABASE_PATH=database/SmartApply.db
# DATABASE_URL=postgresql://username:password@host:5432/smartapply

# SMTP email / OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

OTP_DEMO_MODE=false
OTP_EXPIRY_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_RECIPIENT_NUMBER_OVERRIDE=false
OTP_RECIPIENT_NUMBER=your_number
SMS_PROVIDER=msg91
MSG91_API_KEY=your_msg91_api_key
MSG91_SENDER_ID=your_msg91_sender_id

# AI Auto Apply
GEMINI_API_KEY=your_gemini_api_key

# Field-level encryption
ENCRYPTION_KEY=your_fernet_encryption_key

# Smart Job Search
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_DEMO_MODE=false
GOOGLE_DEMO_EMAIL=demo.google.user@example.com
GOOGLE_DEMO_NAME=Google Demo User